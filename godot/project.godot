; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Void Sovereigns"
config/description="A single-player sci-fi extraction FPS."
config/version="1.0.0"
config/tags=PackedStringArray("fps", "singleplayer", "horror", "extraction")
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
boot_splash/bg_color=Color(0.043, 0.055, 0.067, 1)
config/icon="res://icon.png"

[autoload]

SaveSystem="*res://scripts/system/SaveSystem.gd"
Global="*res://scripts/Global.gd"
GameSettings="*res://scripts/system/GameSettings.gd"
ContentRegistry="*res://scripts/content/ContentRegistry.gd"
MissionState="*res://scripts/autoloads/MissionState.gd"
LoadoutState="*res://scripts/autoloads/LoadoutState.gd"
InventoryState="*res://scripts/autoloads/InventoryState.gd"
EconomyState="*res://scripts/autoloads/EconomyState.gd"
SurvivalState="*res://scripts/autoloads/SurvivalState.gd"
ProgressionState="*res://scripts/autoloads/ProgressionState.gd"
SceneManager="*res://scripts/autoloads/SceneManager.gd"
GameAssetManager="*res://scripts/autoloads/GameAssetManager.gd"
DataManager="*res://scripts/content/DataManager.gd"
HitPipeline="*res://scripts/combat/HitPipeline.gd"
QuestGraphEngine="*res://scripts/quests/QuestGraphEngine.gd"
SpawnTrackerManager="*res://scripts/system/SpawnTrackerManager.gd"
SteamService="*res://scripts/steam/SteamService.gd"
PauseMenu="*res://scripts/ui/menu/PauseMenu.gd"

[debug]

gdscript/warnings/untyped_declaration=1

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1600
window/size/window_height_override=900
window/size/initial_position_type=1
window/size/min_width=1024
window/size/min_height=600
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

